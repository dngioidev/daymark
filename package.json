{
  "name": "daymark",
  "private": true,
  "version": "1.9.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --production",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for(const d of [\\\"dist\\\",\\\"coverage\\\"])require(\\\"fs\\\").rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "validate:ai": "node .ai-configs/scripts/validate-configs.mjs",
    "test": "vitest run",
    "test:helpers": "node --test --test-concurrency=1 scripts/helpers/cycle-7-fixture.test.mjs scripts/helpers/server-session.test.mjs scripts/helpers/site.test.mjs scripts/helpers/zoom.test.mjs scripts/helpers/guide.test.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-android-pwa.mjs --no-shots",
    "android:sync": "vite build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "test:sync": "node scripts/e2e-sync.mjs",
    "test:qa": "node scripts/e2e-qa-regressions.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "description": "Local-first daily markdown notebook with task carry-forward",
  "engines": {
    "node": ">=20"
  }
}
