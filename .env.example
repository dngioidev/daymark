# Daymark self-hosted server configuration (copy to .env, or pass as environment variables)

# Admin account. DAYMARK_PASSWORD is required on the first production start
# (8+ characters); it is then stored hashed in DATA_DIR/auth.json and can be
# changed from the app. To reset it, stop the server and delete DATA_DIR/auth.json.
DAYMARK_USER="admin"
DAYMARK_PASSWORD=""

# Where the vault, devices and sync log are stored (default ./data)
DATA_DIR="./data"

# HTTP port (default 3000)
PORT=3000

# Express proxy trust (default loopback). Behind Docker + Caddy use e.g. uniquelocal
# and bind the published port to 127.0.0.1:3000:3000, so clients cannot spoof proxy headers.
DAYMARK_TRUST_PROXY="loopback"

# Browser origins allowed to call the API: * (default) or a comma-separated list
DAYMARK_CORS_ORIGINS="*"

# AI connections (MCP). The public HTTPS origin, no trailing slash, e.g. https://daymark.example.com.
# In production /mcp and the connector sign-in are only served when this is set.
DAYMARK_PUBLIC_URL=""
# Set to off to never serve /mcp, whatever the in-app switch says (default on).
DAYMARK_MCP=""
# Fallback IANA time zone for AI dates, e.g. Asia/Ho_Chi_Minh (the AI connections tab's saved zone wins).
DAYMARK_TZ=""

# Refresh token lifetime in days, renewed on refresh (default 30); replaces DAYMARK_TOKEN_TTL_DAYS.
# Use a positive, finite number; invalid or <= 0 values fall back to 30.
DAYMARK_REFRESH_TTL_DAYS=30
